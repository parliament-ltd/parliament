msgid "welcome.foot.licence"
msgstr "MIT licensed. Source published at launch"

#. js-lingui-explicit-id
msgid "welcome.foot.made"
msgstr "Created with Claude Code"

#. js-lingui-explicit-id
msgid "welcome.heading"
msgstr "Welcome"

#. The heading finishes its sentence when the steps are done: Welcome / to Parliament
#. js-lingui-explicit-id
msgid "welcome.headingTo"
msgstr "to Parliament"

#. js-lingui-explicit-id
msgid "welcome.keepAsk"
msgstr "ask the browser again"

#. js-lingui-explicit-id
msgid "welcome.keepAsking"
msgstr "asking"

#. {board} is Settings, from COPY.boards
#. js-lingui-explicit-id
msgid "welcome.keepBackup"
msgstr "back up in {board}"

#. js-lingui-explicit-id
msgid "welcome.keepNot"
msgstr "This browser has not agreed to keep what you make here, so it may clear it to save space, or each time it closes. To keep it, let this site keep its data in the browser’s settings, and back up now and then."

#. js-lingui-explicit-id
msgid "welcome.letter.1"
msgstr "Parliament is a place to work with AI on your own terms. It is early, and still being built."

#. js-lingui-explicit-id
msgid "welcome.letter.2"
msgstr "It runs in your browser, with no servers and no accounts. Your chats and keys stay on this computer, and each request goes straight to the provider you pick, to a model running on your own machine, or just Wikipedia. There are no ads."

#. js-lingui-explicit-id
msgid "welcome.letter.3"
msgstr "With the goal of rethinking how we interact with AI, it is yours to shape. Rooms are built from blocks, layouts and themes. You create the space, you choose how to interact."

#. js-lingui-explicit-id
msgid "welcome.letter.4"
msgstr "Most AI apps are built for passive consumption. You ask something, you receive a response. Here you steer from a command line: branch chats, highlight, add and combine notes across chats, plan a run of prompts, and more. Let's take back control."

#. {command} is focus:, which stays English
#. js-lingui-explicit-id
msgid "welcome.now"
msgstr "Now, let’s {command}"

#. The letter is signed with this name after a dash
#. js-lingui-explicit-id
msgid "welcome.signature"
msgstr "So Lov"

#. js-lingui-explicit-id
msgid "welcome.small"
msgstr "built for a computer for now; the phone comes later"

#. js-lingui-explicit-id
msgid "welcome.step.almanac"
msgstr "See what you have made"

#. js-lingui-explicit-id
msgid "welcome.step.ask"
msgstr "Ask something"

#. {command} is p>, which stays English
#. js-lingui-explicit-id
msgid "welcome.step.askHow"
msgstr "{command} and a question"

#. js-lingui-explicit-id
msgid "welcome.step.bar"
msgstr "Move the bar to the bottom"

#. js-lingui-explicit-id
msgid "welcome.step.command"
msgstr "Open the command line"

#. js-lingui-explicit-id
msgid "welcome.step.key"
msgstr "Add an AI API key"

#. js-lingui-explicit-id
