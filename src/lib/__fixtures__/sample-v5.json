        "messages": [
          {
            "id": "m1",
            "conversationId": "c1",
            "role": "user",
            "content": "When was the water tower on Hill Road built?",
            "tokenCount": 11,
            "incomplete": false,
            "createdAt": "2026-04-03T10:00:00.000Z"
          },
          {
            "id": "m2",
            "conversationId": "c1",
            "role": "assistant",
            "content": "It was finished in 1931, in a stripped-down Bauhaus style, and renovated once since.",
            "tokenCount": 21,
            "incomplete": false,
            "createdAt": "2026-04-03T10:00:08.000Z"
          },
          {
            "id": "m3",
            "conversationId": "c1",
            "role": "user",
            "content": "Who designed it?",
            "tokenCount": 4,
            "incomplete": false,
            "createdAt": "2026-04-03T10:02:00.000Z"
          },
          {
            "id": "m4",
            "conversationId": "c1",
            "role": "assistant",
            "content": "The town engineer drew it, with a local architect for the facade.",
            "tokenCount": 17,
            "incomplete": false,
            "createdAt": "2026-04-03T10:02:09.000Z"
          },
          {
            "id": "m5",
            "conversationId": "c1",
            "role": "user",
            "content": "What did it cost?",
            "tokenCount": 5,
            "incomplete": false,
            "createdAt": "2026-04-03T10:04:00.000Z"
          },
          {
            "id": "m6",
            "conversationId": "c1",
            "role": "assistant",
            "content": "About a third of the town budget that year, paid partly with matching funds.",
            "tokenCount": 19,
            "incomplete": false,
            "createdAt": "2026-04-03T10:04:07.000Z"
          }
        ],
        "familyId": "c1",
        "tags": [
          "history",
          "architecture"
        ]
      },
